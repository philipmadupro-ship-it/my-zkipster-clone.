rules_version = '2';

// The browser only ever READS from Firestore (the dashboard's live listeners).
// Every write goes through the Next.js API routes, which use the Admin SDK and
// bypass these rules, so client-side writes are denied outright.
//
// Public pages (RSVP, invitation, campaign claim) are rendered on the server
// with the Admin SDK too, so they need no client access either.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // Admins can read the campaigns they own.
    match /campaigns/{campaignId} {
      allow read: if signedIn() && resource.data.ownerEmail == callerEmail();
      allow write: if false;
    }

    // Admins can read guests that belong to a campaign they own.
    match /guests/{guestId} {
      allow read: if signedIn()
        && get(/databases/$(database)/documents/campaigns/$(resource.data.campaignId)).data.ownerEmail == callerEmail();
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
