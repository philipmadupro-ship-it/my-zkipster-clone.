rules_version = '2';

// Nothing in the browser talks to Firestore any more. Every read and write goes
// through the Next.js API routes and server-rendered pages, which use the Admin
// SDK and bypass these rules. So the rules can simply refuse all direct access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
