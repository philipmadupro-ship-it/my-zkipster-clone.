# Firebase is only used as the database (Firestore), and only from the server.
# The old NEXT_PUBLIC_FIREBASE_* variables are no longer needed and can be deleted.

# Firebase Admin (server-only, keep secret)
# Option 1: paste the full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 2: individual fields (used if FIREBASE_SERVICE_ACCOUNT_JSON is not set)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Who can sign in: a JSON object of email -> password (1 or 2 people). REQUIRED.
# To change a password or add/remove someone, edit this and redeploy.
# Avoid " and \ inside passwords. Use long ones (12+ characters).
ADMIN_LOGINS={"press@ungaro.com":"change-this-long-password"}

# Secret that signs the login cookie (>= 32 characters). REQUIRED. Generate one with:
#   openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# Secret used to sign guest RSVP links (>= 32 characters). REQUIRED to send invitations
# or to use the /c/<slug> claim page. Generate one with:  openssl rand -base64 48
# Changing it invalidates every signed link already sent.
RSVP_LINK_SECRET=

# Links sent before signing existed are bare guest IDs and still work by default.
# Once you have re-sent invitations/reminders, set this to false to reject them.
# RSVP_ALLOW_LEGACY_LINKS=false

# Gemini
GEMINI_API_KEY=

# App URL (no trailing slash)
# VERCEL: Set this to your actual production URL (e.g. https://pfwinvites.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP Configuration (Outlook / Office 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=pressoffice@ungaro.com
SMTP_PASS=
SMTP_SECURE=false

# Firebase Extended (Optional overrides)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
